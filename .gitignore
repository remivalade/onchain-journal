!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Remix dependencies
.deps/

# Build and cache artifacts
artifacts/
cache/
build/

# Next.js
/web/.next/
/web/out/

# Log files
*.log
npm-debug.log*
